# ─────────────────────────────────────────────────────────────────────────────
# Growth Suite — environment configuration
# Copy to .env (local) or set in your hosting provider. Never commit real values.
# Every third-party integration runs in MOCK mode until its keys are set, so the
# app works end-to-end without any of them. See docs/INTEGRATIONS.pdf for how to
# obtain each credential.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
APP_NAME="Growth Suite"
# Local setup: use APP_URL=http://localhost:3000 and INTEGRATIONS_MODE=mock.
# PostgreSQL must use UTF-8 encoding. npm database/worker/smoke commands load .env.
APP_URL=https://app.yourdomain.com            # public base URL of this deployment (no trailing slash)
DATABASE_URL=postgresql://user:password@host:5432/growth_suite?sslmode=require
DATABASE_POOL_MAX=10
SESSION_SECRET=                                # 32+ random characters:  openssl rand -base64 48
ENCRYPTION_KEY=                                # exactly 32 bytes, base64: openssl rand -base64 32  (encrypts stored tokens)
CRON_SECRET=                                   # random string; scheduler calls /api/cron/tick with "Authorization: Bearer <CRON_SECRET>"
DEFAULT_SITE_DOMAIN=localhost                  # site used on localhost, or for every host when SINGLE_SITE_MODE=true
SINGLE_SITE_MODE=false                         # true = self-hosted single website (any domain serves the default site)
INTEGRATIONS_MODE=auto                         # auto = use real providers where keys are set; mock = never call providers

# First admin created by `npm run db:seed`
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=                                # at least 10 characters, letters and numbers

# ── File storage ─────────────────────────────────────────────────────────────
# Local disk (fine for one server). For multiple servers / serverless use S3-compatible storage.
STORAGE_DIR=./storage
PUBLIC_UPLOADS_BASE=/uploads
S3_BUCKET=
S3_REGION=                                     # e.g. eu-west-2, or "auto" for Cloudflare R2
S3_ENDPOINT=                                   # leave blank for AWS; R2: https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=                            # CDN / public bucket URL, e.g. https://media.yourdomain.com

# ── AI providers (one or both) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=                                # also used for embeddings (knowledge search)
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Meta: WhatsApp Cloud API, Pixel/CAPI, Lead Ads, Pages/Instagram ─────────
META_APP_ID=
META_APP_SECRET=                               # verifies webhook signatures (X-Hub-Signature-256) — REQUIRED in production
META_GRAPH_VERSION=v21.0
META_SYSTEM_USER_TOKEN=                        # system-user token: whatsapp_business_messaging, whatsapp_business_management, pages_manage_posts, instagram_content_publish, leads_retrieval
META_PARTNER_BUSINESS_ID=                      # your Business Manager ID that clients share assets with
WHATSAPP_ACCESS_TOKEN=                         # usually the same system-user token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=                 # any random string; enter the same value in the Meta app webhook settings
META_LEADS_WEBHOOK_VERIFY_TOKEN=               # random string for the Lead Ads (leadgen) webhook
# Per-site values (Pixel ID, CAPI token, Page token, WABA ID) are entered in Admin → Integrations / WhatsApp, stored encrypted.

# ── Google ───────────────────────────────────────────────────────────────────
# Per-site: GTM container ID, GA4 Measurement ID + Measurement Protocol secret are entered in Admin → Integrations.
GOOGLE_CLIENT_ID=                              # reserved for Google sign-in / Calendar OAuth (roadmap)
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=                   # for Google Calendar sync of staff bookings (roadmap)

# ── Payments ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=                               # India (INR)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                       # webhook: <APP_URL>/api/public/payments/razorpay
STRIPE_SECRET_KEY=                             # rest of the world
STRIPE_WEBHOOK_SECRET=                         # webhook: <APP_URL>/api/public/payments/stripe  (event: checkout.session.completed)

# ── Email (SMTP — any provider: Postmark, SES, SendGrid, Mailgun, Google Workspace) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Growth Suite <no-reply@yourdomain.com>"

# ── Search API (QnA finder, Instagram search, market trends) ─────────────────
SERPER_API_KEY=

# ── Video calls ──────────────────────────────────────────────────────────────
DAILY_API_KEY=                                 # Daily.co; without it a Jitsi Meet link is used

# ── Paid modules (optional licensing for resale / self-host) ─────────────────
LICENCE_PUBLIC_KEY=                            # Ed25519 public key (PEM). Leave blank = all modules available.
LICENCE_PRIVATE_KEY=                           # only on the platform that issues licences

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_INTERVAL_MS=60000

# Shared rate limits across app instances. Blank = bounded in-memory development fallback.
# Use rediss:// for TLS. All instances must share SESSION_SECRET and this Redis store.
# A configured Redis outage rejects protected requests rather than bypassing limits.
REDIS_URL=
# Browser tests (optional): defaults to BASE_URL, then localhost:3000.
E2E_BASE_URL=
# CI starts the server before Playwright; set true only to reuse that server.
E2E_REUSE_SERVER=
# Optional error tracking; blank disables external reporting. Mock mode records safe metadata only.
SENTRY_DSN=

# Raw analytics: keep the current UTC month plus this many prior complete months.
# 0 disables pruning; supported range 0-120. Existing lead records are unaffected.
ANALYTICS_RETENTION_MONTHS=12

# Two-factor authentication uses ENCRYPTION_KEY above; no external provider keys are required.
